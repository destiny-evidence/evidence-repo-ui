@prefix dct: <http://purl.org/dc/terms/> .
@prefix esea: <https://vocab.esea.education/> .
@prefix evrepo: <https://vocab.evidence-repository.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esea:attrition a owl:ObjectProperty ;
    rdfs:label "attrition" ;
    dct:description "Reported attrition or dropout rate as a percentage (0 to 100)." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:NumericCodingAnnotation .

esea:cost a owl:ObjectProperty ;
    rdfs:label "cost" ;
    dct:description "Whether the research contains quantitative costing data. Binary yes/no field coded as StringCodingAnnotation." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:country a owl:ObjectProperty ;
    rdfs:label "country" ;
    dct:description "Country or countries where the study was conducted. Values are ISO 3166-1 alpha-2 codes (e.g., 'KE' for Kenya, 'GH' for Ghana). Multiple values may be coded." ;
    rdfs:domain evrepo:Context ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:countryLevel1 a owl:ObjectProperty ;
    rdfs:label "country level 1" ;
    dct:description "Sub-national region, province, state, or administrative division (country Level 1). Open text field allowing multiple values." ;
    rdfs:domain evrepo:Context ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:dataSource a rdf:Property ;
    rdfs:label "data source" ;
    dct:description "System-generated field capturing the organization or system that entered the coding annotation." ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range xsd:string .

esea:documentType a owl:ObjectProperty ;
    rdfs:label "document type" ;
    dct:description "The format and purpose of the document â€” e.g. journal article, report, working paper. Placed on Investigation since it describes the type of study reported." ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range esea:DocumentTypeCodingAnnotation .

esea:duration a owl:ObjectProperty ;
    rdfs:label "duration" ;
    dct:description "Length of the intervention, typically measured in weeks. Numeric field." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range evrepo:NumericCodingAnnotation .

esea:educationLevel a owl:ObjectProperty ;
    rdfs:label "education level" ;
    dct:description "The ISCED-aligned level of education in which the target population is participating. Based on ISCED 2011, with additions from the INEE framework for informal education. Multiple values may be coded." ;
    rdfs:domain evrepo:Context ;
    rdfs:range esea:EducationLevelCodingAnnotation .

esea:educationTheme a owl:ObjectProperty ;
    rdfs:label "education theme" ;
    dct:description "Strategic domain of focus within education systems that the intervention or policy addresses. 2-level hierarchy: category and specific theme. Multiple values may be coded." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range esea:EducationThemeCodingAnnotation .

esea:funderIntervention a owl:ObjectProperty ;
    rdfs:label "funder intervention" ;
    dct:description "Organization or entity that funded the intervention being evaluated. Open text field." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:funderResearch a owl:ObjectProperty ;
    rdfs:label "funder research" ;
    dct:description "Organization or entity that funded the research or study. Open text field." ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:groupDifferences a owl:ObjectProperty ;
    rdfs:label "group differences" ;
    dct:description "Binary indicator of whether baseline group differences were reported. Coded as yes/no in StringCodingAnnotation." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:implementationDescription a owl:ObjectProperty ;
    rdfs:label "implementation description" ;
    dct:description "Type of implementation activity or modality. Multiple values may be coded." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range esea:ImplementationDescriptionCodingAnnotation .

esea:implementationFidelity a owl:ObjectProperty ;
    rdfs:label "implementation fidelity" ;
    dct:description "Type of fidelity or adherence measurement reported in the study." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range esea:ImplementationFidelityCodingAnnotation .

esea:implementationName a owl:ObjectProperty ;
    rdfs:label "implementation name" ;
    dct:description "Name or title of the intervention. Open text field." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:implementerType a owl:ObjectProperty ;
    rdfs:label "implementer type" ;
    dct:description "The type of organization implementing the intervention. Single-select enumerated type." ;
    rdfs:domain evrepo:Intervention ;
    rdfs:range esea:ImplementerTypeCodingAnnotation .

esea:isRetracted a owl:DatatypeProperty ;
    rdfs:label "is retracted" ;
    dct:description "Boolean flag indicating whether the publication has been retracted. Retrieved from OpenAlex or other metadata source." ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range xsd:boolean .

esea:outcome a owl:ObjectProperty ;
    rdfs:label "outcome" ;
    dct:description "Type of educational or other outcome measured. 2-level hierarchy: access/education/externalities/learning/returns categories with specific outcome types. Multiple values may be coded." ;
    rdfs:domain evrepo:Outcome ;
    rdfs:range esea:OutcomeCodingAnnotation .

esea:participants a owl:ObjectProperty ;
    rdfs:label "participants" ;
    dct:description "The stakeholder group for whom the outcomes apply (e.g., Students, Teachers, Parents, School Leaders). Open text field; multiple values may be coded." ;
    rdfs:domain evrepo:Context ;
    rdfs:range evrepo:StringCodingAnnotation .

esea:sampleFeatures a owl:ObjectProperty ;
    rdfs:label "sample features" ;
    dct:description "Characteristics of the study sample. Multiple values may be coded." ;
    rdfs:domain evrepo:Context ;
    rdfs:range esea:SampleFeaturesCodingAnnotation .

esea:sampleSize a owl:ObjectProperty ;
    rdfs:label "sample size" ;
    dct:description "Total number of participants in the study. Integer field." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:NumericCodingAnnotation .

esea:setting a owl:ObjectProperty ;
    rdfs:label "setting" ;
    dct:description "Physical or organizational setting where education provision occurs. 3-level hierarchy: Formal / Informal-NonFormal / Contextual, with specific setting types. Multiple values may be coded." ;
    rdfs:domain evrepo:Context ;
    rdfs:range esea:SettingCodingAnnotation .

esea:studyDesign a owl:ObjectProperty ;
    rdfs:label "study design" ;
    dct:description "The research design methodology of the investigation." ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range esea:StudyDesignCodingAnnotation .

evrepo:ControlCondition a owl:Class ;
    rdfs:label "Control Condition" ;
    dct:description "A comparison state without the intervention of interest (e.g. business-as-usual, waitlist, active control, placebo)." ;
    rdfs:subClassOf evrepo:Condition .

evrepo:TemporalCondition a owl:Class ;
    rdfs:label "Temporal Condition" ;
    dct:description "A time-defined measurement occasion (e.g. pre-test, post-test, follow-up, pre-policy period)." ;
    rdfs:subClassOf evrepo:Condition .

evrepo:baselineAdjusted a owl:DatatypeProperty ;
    rdfs:label "baseline adjusted" ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:boolean .

evrepo:clusterCount a owl:DatatypeProperty ;
    rdfs:label "cluster count" ;
    dct:description "Number of clusters (schools, classrooms, etc.) for cluster RCTs." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:clusteringAdjusted a owl:DatatypeProperty ;
    rdfs:label "clustering adjusted" ;
    dct:description "Whether clustering was accounted for. Values: yes, no, unknown, not-applicable." ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:string .

evrepo:codedBy a rdf:Property ;
    rdfs:label "coded by" ;
    dct:description "The agent (human coder or LLM) who performed the coding." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:CodingAnnotation evrepo:EffectEstimate evrepo:ObservedResult ) ] .

evrepo:comparedTo a owl:ObjectProperty ;
    rdfs:label "compared to" ;
    dct:description "The condition being compared against (control, pre-test, etc.)." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:Condition .

evrepo:confidenceIntervalLower a owl:DatatypeProperty ;
    rdfs:label "confidence interval lower bound" ;
    dct:description "Applies to EffectEstimate (effect size CI) and ObservedResult (group mean CI)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:EffectEstimate evrepo:ObservedResult ) ] ;
    rdfs:range xsd:decimal .

evrepo:confidenceIntervalUpper a owl:DatatypeProperty ;
    rdfs:label "confidence interval upper bound" ;
    dct:description "Applies to EffectEstimate (effect size CI) and ObservedResult (group mean CI)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:EffectEstimate evrepo:ObservedResult ) ] ;
    rdfs:range xsd:decimal .

evrepo:confidenceLevel a owl:DatatypeProperty ;
    rdfs:label "confidence level" ;
    dct:description "e.g. 0.95 for a 95% confidence interval." ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:decimal .

evrepo:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    dct:description "Links an EffectEstimate back to the ObservedResult(s) it was computed from." ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range evrepo:ObservedResult .

evrepo:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    dct:description "Free-text description of this condition or outcome." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:Condition evrepo:Outcome ) ] ;
    rdfs:range xsd:string .

evrepo:effectSizeMetric a owl:ObjectProperty ;
    rdfs:label "effect size metric" ;
    dct:description "What metric was used: Hedges' g, Cohen's d, odds ratio, etc." ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range evrepo:EffectSizeMetricScheme .

evrepo:estimateSource a owl:ObjectProperty ;
    rdfs:label "estimate source" ;
    dct:description "How this estimate was obtained: computed from summary stats, extracted from paper, etc." ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range evrepo:EstimateSourceScheme .

evrepo:evaluates a owl:ObjectProperty ;
    rdfs:label "evaluates" ;
    dct:description "The condition being evaluated. A positive effect size means this condition outperformed the comparedTo condition." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:Condition .

evrepo:events a owl:DatatypeProperty ;
    rdfs:label "number of events" ;
    dct:description "Number of events for binary outcomes." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:falseNegative a owl:DatatypeProperty ;
    rdfs:label "false negative" ;
    dct:description "Count of test-negative, reference-positive cases." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:falsePositive a owl:DatatypeProperty ;
    rdfs:label "false positive" ;
    dct:description "Count of test-positive, reference-negative cases." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:forCondition a owl:ObjectProperty ;
    rdfs:label "for condition" ;
    dct:description "Which condition this arm data is for. Makes each ObservedResult self-describing without traversing back to the Finding." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range evrepo:Condition .

evrepo:hasArmData a owl:ObjectProperty ;
    rdfs:label "has arm data" ;
    dct:description "Links a Finding to per-arm summary statistics. A two-arm trial typically has two ObservedResults; multi-arm trials have more." ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:ObservedResult .

evrepo:hasContext a owl:ObjectProperty ;
    rdfs:label "has context" ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:Context .

evrepo:hasEffectEstimate a owl:ObjectProperty ;
    rdfs:label "has effect estimate" ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:EffectEstimate .

evrepo:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding" ;
    rdfs:domain evrepo:Investigation ;
    rdfs:range evrepo:Finding .

evrepo:hasInvestigation a owl:ObjectProperty ;
    rdfs:label "has investigation" ;
    rdfs:domain evrepo:LinkedDataEnhancement ;
    rdfs:range evrepo:Investigation .

evrepo:hasOutcome a owl:ObjectProperty ;
    rdfs:label "has outcome" ;
    rdfs:domain evrepo:Finding ;
    rdfs:range evrepo:Outcome .

evrepo:icc a owl:DatatypeProperty ;
    rdfs:label "intraclass correlation coefficient" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:mean a owl:DatatypeProperty ;
    rdfs:label "mean" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:n a owl:DatatypeProperty ;
    rdfs:label "sample size" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    dct:description "Short name or title for this condition or outcome (e.g. intervention programme name, control label)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:Condition evrepo:Outcome ) ] ;
    rdfs:range xsd:string .

evrepo:pointEstimate a owl:DatatypeProperty ;
    rdfs:label "point estimate" ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:decimal .

evrepo:preMean a owl:DatatypeProperty ;
    rdfs:label "pre-test mean" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:preSd a owl:DatatypeProperty ;
    rdfs:label "pre-test standard deviation" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:sd a owl:DatatypeProperty ;
    rdfs:label "standard deviation" ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:se a owl:DatatypeProperty ;
    rdfs:label "standard error" ;
    dct:description "Standard error of the mean. Alternative to sd when that is what is reported." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:decimal .

evrepo:sourceLocation a rdf:Property ;
    rdfs:label "source location" ;
    dct:description "Location in the source document where the data was found (e.g. table number, page reference)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:EffectEstimate evrepo:ObservedResult ) ] ;
    rdfs:range xsd:string .

evrepo:standardError a owl:DatatypeProperty ;
    rdfs:label "standard error" ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:decimal .

evrepo:status a owl:ObjectProperty ;
    rdfs:label "status" ;
    dct:description "The lifecycle state of this coding annotation." ;
    rdfs:domain evrepo:CodingAnnotation ;
    rdfs:range evrepo:CodingStatus .

evrepo:supportingText a rdf:Property ;
    rdfs:label "supporting text" ;
    dct:description "Verbatim or near-verbatim text from the source material that supports the coded value." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( evrepo:CodingAnnotation evrepo:EffectEstimate evrepo:ObservedResult ) ] ;
    rdfs:range xsd:string .

evrepo:trueNegative a owl:DatatypeProperty ;
    rdfs:label "true negative" ;
    dct:description "Count of test-negative, reference-negative cases." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:truePositive a owl:DatatypeProperty ;
    rdfs:label "true positive" ;
    dct:description "Count of test-positive, reference-positive cases." ;
    rdfs:domain evrepo:ObservedResult ;
    rdfs:range xsd:integer .

evrepo:variance a owl:DatatypeProperty ;
    rdfs:label "variance" ;
    rdfs:domain evrepo:EffectEstimate ;
    rdfs:range xsd:decimal .

esea:DocumentTypeCodingAnnotation a owl:Class ;
    rdfs:label "Document Type Coding Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom esea:DocumentTypeConcept ;
            owl:onProperty evrepo:codedValue ],
        evrepo:CodingAnnotation .

<https://vocab.esea.education/DocumentTypeScheme/C00008> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Peer-reviewed publication presenting original research or reviews." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Journal Article" .

<https://vocab.esea.education/DocumentTypeScheme/C00009> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Preliminary findings, not yet peer-reviewed." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Pre-print/Working Paper" .

<https://vocab.esea.education/DocumentTypeScheme/C00010> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Contribution to an edited academic volume." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Book Chapter" .

<https://vocab.esea.education/DocumentTypeScheme/C00011> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Research shared at academic or professional conferences." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Conference Paper" .

<https://vocab.esea.education/DocumentTypeScheme/C00012> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Graduate-level academic research (e.g. MA, PhD)." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Thesis/Dissertation" .

<https://vocab.esea.education/DocumentTypeScheme/C00013> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Any kind of report published by a state or national government." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Government Report/Document" .

<https://vocab.esea.education/DocumentTypeScheme/C00014> a skos:Concept,
        esea:DocumentTypeConcept ;
    skos:definition "Any other report, e.g. a technical report, project report, or annual report from a non-governmental institution or organisation." ;
    skos:inScheme esea:DocumentTypeScheme ;
    skos:prefLabel "Other Report (Technical/Institutional)" .

esea:EducationLevelCodingAnnotation a owl:Class ;
    rdfs:label "Education Level Coding Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom esea:EducationLevelConcept ;
            owl:onProperty evrepo:codedValue ],
        evrepo:CodingAnnotation .

<https://vocab.esea.education/EducationLevelScheme/C00001> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Early childhood education and care, including ECD centres, community-based playgroups, nursery, and pre-primary programmes." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Early Childhood" .

<https://vocab.esea.education/EducationLevelScheme/C00002> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Primary education, typically covering grades 1-6 depending on country context." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Primary Education" .

<https://vocab.esea.education/EducationLevelScheme/C00003> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Lower secondary education (junior secondary, middle school), typically covering grades 7-9." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Lower Secondary" .

<https://vocab.esea.education/EducationLevelScheme/C00004> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Upper secondary education (senior secondary), typically covering grades 10-12." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Upper Secondary" .

<https://vocab.esea.education/EducationLevelScheme/C00005> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:altLabel "TVET" ;
    skos:definition "Technical and vocational institutes, polytechnics, teacher training colleges (pre-Bachelor), health training institutes." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Technical Vocational Education and Training" .

<https://vocab.esea.education/EducationLevelScheme/C00006> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Accelerated education programmes, Alternative Basic Education, second chance programmes, youth livelihoods training, speed schools." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Alternative Education" .

<https://vocab.esea.education/EducationLevelScheme/C00007> a skos:Concept,
        esea:EducationLevelConcept ;
    skos:definition "Learning readiness, catch-up programmes, bridging programmes (e.g. language)." ;
    skos:inScheme esea:EducationLevelScheme ;
    skos:prefLabel "Transitional Programs" .

esea:EducationThemeCodingAnnotation a owl:Class ;
    rdfs:label "Education Theme Coding Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom esea:EducationThemeConcept ;
            owl:onProperty evrepo:codedValue ],
        evrepo:CodingAnnotation .

<https://vocab.esea.education/EducationThemeScheme/C00024> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Equity and Inclusion: Socio-economic Status" .

<https://vocab.esea.education/EducationThemeScheme/C00025> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Equity and Inclusion: Special Education" .

<https://vocab.esea.education/EducationThemeScheme/C00026> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Equity and Inclusion: Migrants and Refugees" .

<https://vocab.esea.education/EducationThemeScheme/C00027> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Equity and Inclusion: Gender" .

<https://vocab.esea.education/EducationThemeScheme/C00028> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "School Attendance" .

<https://vocab.esea.education/EducationThemeScheme/C00029> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Drop-out Prevention" .

<https://vocab.esea.education/EducationThemeScheme/C00030> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Health and Nutrition" .

<https://vocab.esea.education/EducationThemeScheme/C00031> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "School Transportation" .

<https://vocab.esea.education/EducationThemeScheme/C00032> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Student Mobility" .

<https://vocab.esea.education/EducationThemeScheme/C00033> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Student Engagement and Participation" .

<https://vocab.esea.education/EducationThemeScheme/C00034> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00015> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "School Admissions" .

<https://vocab.esea.education/EducationThemeScheme/C00035> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00016> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Decentralization of System" .

<https://vocab.esea.education/EducationThemeScheme/C00036> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00016> ;
    skos:inScheme esea:EducationThemeScheme ;
    skos:prefLabel "Education Accountability" .

<https://vocab.esea.education/EducationThemeScheme/C00037> a skos:Concept,
        esea:EducationThemeConcept ;
    skos:broader <https://vocab.esea.education/EducationThemeScheme/C00016> ;
